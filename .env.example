# ==================================================
# JALAMITRA Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit real secret keys or passwords to Git.
# ==================================================

# Database Connection (SQLite for local dev, PostgreSQL/Supabase/Neon for Vercel production)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Generate a strong random string in production)
JWT_SECRET="jalamitra-production-jwt-secret-replace-in-prod-2026"

# Google Gemini AI API Key (Server-side only for JALAMITRA AI Assistant)
GEMINI_API_KEY=""

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional MQTT Broker Settings (For real-time ESP32 MQTT pub/sub integration)
MQTT_BROKER_URL="mqtts://broker.emqx.io:8883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="jalamitra_server_gateway"

# Optional External ESP32 Gateway URL (If running a separate Node.js/Python MQTT microservice)
ESP32_API_URL="http://localhost:3000/api/device/telemetry"
